# SynapSys BCI defaults (ESP-IDF v5.3, ESP32-S3-DevKitC-1).
# Applied only when sdkconfig does not exist yet: after editing, `idf.py fullclean`
# or delete sdkconfig, or change values with `idf.py menuconfig`.

CONFIG_IDF_TARGET="esp32s3"

# CPU / RTOS
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Flash / partitions: NimBLE + ~141 KiB of embedded fixtures may not fit the 1 MB default
# app partition; the built-in "single app large" table gives a 1.5 MB factory app.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Console on the native USB port (USB-Serial/JTAG): one cable for flash + monitor.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Bluetooth: NimBLE host, peripheral role only, one connection.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=185
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="SynapSys"
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
